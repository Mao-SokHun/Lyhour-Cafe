# ==============================================================================
# LYHOUR COFFEE & CAKE — ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env for local development or enter these in Render Dashboard
# ==============================================================================

# --- 1. CORE & SERVER ---
SPRING_PROFILES_ACTIVE=neon
PORT=8080
APP_BASE_URL=https://lyhour-cafe.onrender.com

# --- 2. NEON POSTGRESQL DATABASE (Required when SPRING_PROFILES_ACTIVE=neon) ---
SPRING_DATASOURCE_URL=jdbc:postgresql://ep-xxxx.us-east-2.aws.neon.tech/cafeshop?sslmode=require
SPRING_DATASOURCE_USERNAME=your_neon_username
SPRING_DATASOURCE_PASSWORD=your_neon_password

# --- 3. TELEGRAM BOT & MINI APP ---
APP_TELEGRAM_ENABLED=true
APP_TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
APP_TELEGRAM_CHAT_ID=your_numeric_staff_chat_id_here

# --- 4. SECURITY & JWT ---
APP_JWT_SECRET=LyhourCoffeeSecretKeyForTelegramAndMobile2026ChangeMe!!
APP_CORS_ALLOWED_ORIGINS=*

# --- 5. CAMBODIAN PAYMENTS (BAKONG KHQR) ---
APP_KHQR_ENABLED=true
APP_KHQR_DEMO_MODE=true
APP_BAKONG_ENABLED=true
APP_ABA_ENABLED=false
APP_WING_ENABLED=false

# --- 6. STORE PRICING & FEES ---
APP_TAX_RATE=0.10
APP_DELIVERY_FEE=3.00

# --- 7. STRIPE PAYMENTS (OPTIONAL) ---
APP_STRIPE_ENABLED=false
APP_STRIPE_SECRET_KEY=
APP_STRIPE_WEBHOOK_SECRET=
APP_STRIPE_SUCCESS_URL=https://lyhour-cafe.onrender.com/order/success?session_id={CHECKOUT_SESSION_ID}
APP_STRIPE_CANCEL_URL=https://lyhour-cafe.onrender.com/cart?cancelled=true

# --- 8. PUSH & BACKUP ---
APP_PUSH_ENABLED=false
APP_BACKUP_ENABLED=true
